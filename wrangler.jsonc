{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mbti-compass",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Vite output — run `npm run build` first (or `npm run deploy`)
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
